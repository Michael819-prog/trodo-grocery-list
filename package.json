{
  "name": "trodo-grocery-list",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20.9.0 <21" },
  "scripts": {
    "dev": "npm run build && npm run db:local && concurrently --kill-others -n api,web \"npm:dev:worker\" \"npm:dev:client\"",
    "dev:client": "vite --host 127.0.0.1",
    "dev:worker": "wrangler dev --ip 127.0.0.1 --port 4173",
    "db:local": "wrangler d1 execute trodo-grocery-db --local --file=./schema.sql",
    "db:remote": "wrangler d1 execute trodo-grocery-db --remote --file=./schema.sql",
    "build": "vite build",
    "deploy": "npm run build && wrangler deploy",
    "test": "node --test"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.7.0",
    "concurrently": "^9.2.1",
    "vite": "^6.0.0",
    "wrangler": "4.20.0"
  }
}
