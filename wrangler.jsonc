{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "trodo-grocery-list",
  "main": "./worker/index.js",
  "compatibility_date": "2026-10-22",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "trodo-grocery-db",
      "database_id": "f35f379f-c909-48da-8d01-1ade12133e34"
    }
  ]
}
